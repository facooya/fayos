.equ DISK_SB_MEM, 0x00000600
.equ DISK_BBM_MEM, 0x0000A000
.equ DISK_IBM_MEM, 0x0000B000
.equ DISK_IT_MEM, 0x0000C000

.equ DISK_CUR_MEM, 0x20000000
